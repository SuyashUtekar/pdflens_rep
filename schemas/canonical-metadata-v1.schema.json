{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/canonical-metadata-v1.schema.json",
  "title": "PDFLens canonical metadata v1.4",
  "type": "object",
  "required": [
    "schema_version",
    "document",
    "processing",
    "pages",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "1.4"
    },
    "document": {
      "type": "object",
      "required": [
        "source_filename",
        "source_sha256",
        "page_count"
      ],
      "properties": {
        "source_filename": {
          "type": "string"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "page_count": {
          "type": "integer",
          "minimum": 0
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "language": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "processing": {
      "type": "object",
      "required": [
        "parser_name",
        "parser_version",
        "status",
        "requested_fields",
        "extracted_fields",
        "missing_fields",
        "warnings",
        "errors",
        "adapter_version",
        "docx_layout_mode",
        "docx_layout_status"
      ],
      "properties": {
        "parser_name": {
          "type": "string"
        },
        "parser_version": {
          "type": "string"
        },
        "model_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string"
        },
        "requested_fields": {
          "$ref": "#/$defs/fields"
        },
        "extracted_fields": {
          "$ref": "#/$defs/fields"
        },
        "missing_fields": {
          "$ref": "#/$defs/fields"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "adapter_version": {
          "type": "string"
        },
        "run_id": {
          "type": ["string", "null"]
        },
        "processed_at_utc": {
          "type": ["string", "null"]
        },
        "build_id": {
          "type": ["string", "null"]
        },
        "configuration": {
          "type": "object"
        },
        "dependency_versions": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "warning_summary": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "page_quality_summary": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "docx_layout_mode": {"type": "string"},
        "docx_layout_status": {"type": "string"},
        "docx_page_width_pt": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "docx_page_height_pt": {"type": ["number", "null"], "exclusiveMinimum": 0}
      },
      "additionalProperties": false
    },
    "pages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/page"
      }
    },
    "artifacts": {
      "type": "object",
      "required": [
        "html_path",
        "docx_path",
        "image_paths",
        "table_snapshot_paths",
        "manifest_path"
      ],
      "properties": {
        "html_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "docx_path": {
          "type": "string"
        },
        "image_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "table_snapshot_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "manifest_path": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "fields": {
      "type": "array",
      "items": {
        "enum": [
          "body_text",
          "heading",
          "header",
          "footer",
          "page_number",
          "footnote",
          "hyperlink",
          "image",
          "table",
          "caption",
          "list",
          "equation",
          "form_field",
          "code",
          "other"
        ]
      }
    },
    "bbox": {
      "type": "object",
      "required": [
        "x0",
        "y0",
        "x1",
        "y1"
      ],
      "properties": {
        "x0": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y0": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "x1": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y1": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "element": {
      "type": "object",
      "required": [
        "element_id",
        "type",
        "reading_order",
        "attributes"
      ],
      "properties": {
        "element_id": {
          "type": "string"
        },
        "type": {
          "enum": [
            "body_text",
            "heading",
            "header",
            "footer",
            "page_number",
            "footnote",
            "hyperlink",
            "image",
            "table",
            "caption",
            "list",
            "equation",
            "form_field",
            "code",
            "other"
          ]
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "reading_order": {
          "type": "integer",
          "minimum": 0
        },
        "bbox": {
          "anyOf": [
            {
              "$ref": "#/$defs/bbox"
            },
            {
              "type": "null"
            }
          ]
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "target_uri": {
          "type": [
            "string",
            "null"
          ]
        },
        "artifact_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "attributes": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "page": {
      "type": "object",
      "required": [
        "page_number",
        "width_pt",
        "height_pt",
        "rotation_degrees",
        "coordinate_system",
        "elements",
        "physical_page_index",
        "printed_page_label",
        "source_text_char_count",
        "body_text_char_count",
        "duplicate_text_char_count",
        "body_text_to_source_text_ratio",
        "source_text_coverage_before_recovery",
        "source_text_coverage_ratio",
        "normalized_source_char_count",
        "normalized_output_char_count",
        "missing_span_count",
        "unmatched_source_char_count",
        "unmatched_source_token_count",
        "recovered_source_char_count",
        "fallback_used",
        "fallback_chars_added",
        "fallback_overlap_chars_removed",
        "fallback_overlap_decisions",
        "text_quality_status",
        "hyperlink_count",
        "hyperlink_unresolved_target_count",
        "hyperlink_malformed_uri_count",
        "field_status",
        "warnings"
      ],
      "properties": {
        "page_number": {
          "type": "integer",
          "minimum": 1
        },
        "width_pt": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height_pt": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rotation_degrees": {
          "type": "integer"
        },
        "coordinate_system": {
          "const": "normalized_top_left_0_1"
        },
        "body_text": {
          "type": "string"
        },
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/element"
          }
        },
        "physical_page_index": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "printed_page_label": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_text_char_count": {
          "type": "integer",
          "minimum": 0
        },
        "body_text_char_count": {
          "type": "integer",
          "minimum": 0
        },
        "duplicate_text_char_count": {
          "type": "integer",
          "minimum": 0
        },
        "body_text_to_source_text_ratio": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "source_text_coverage_before_recovery": {
          "type": ["number", "null"], "minimum": 0, "maximum": 1
        },
        "source_text_coverage_ratio": {
          "type": ["number", "null"], "minimum": 0, "maximum": 1
        },
        "normalized_source_char_count": {"type": "integer", "minimum": 0},
        "normalized_output_char_count": {"type": "integer", "minimum": 0},
        "missing_span_count": {"type": "integer", "minimum": 0},
        "unmatched_source_char_count": {"type": "integer", "minimum": 0},
        "unmatched_source_token_count": {"type": "integer", "minimum": 0},
        "recovered_source_char_count": {"type": "integer", "minimum": 0},
        "fallback_used": {"type": "boolean"},
        "fallback_chars_added": {"type": "integer", "minimum": 0},
        "fallback_overlap_chars_removed": {"type": "integer", "minimum": 0},
        "fallback_overlap_decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["element_id", "element_type", "source_char_count", "decision"],
            "properties": {
              "element_id": {"type": "string"},
              "element_type": {"type": "string"},
              "source_char_count": {"type": "integer", "minimum": 0},
              "decision": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "text_quality_status": {
          "enum": ["unassessed", "passed", "review", "failed"]
        },
        "hyperlink_count": {"type": "integer", "minimum": 0},
        "hyperlink_unresolved_target_count": {"type": "integer", "minimum": 0},
        "hyperlink_malformed_uri_count": {"type": "integer", "minimum": 0},
        "field_status": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "extracted",
              "extracted_unvalidated",
              "validated",
              "needs_review",
              "not_detected",
              "not_requested",
              "failed"
            ]
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
