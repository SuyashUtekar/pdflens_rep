# Copy to .env and enter the exact hosted PDFLens URLs from your API documentation.
# These URLs are read only by the application backend and are never sent to the browser.
PDFLENS_API_SUBMIT_URL=
PDFLENS_API_RESULT_URL=
PDFLENS_API_HEALTH_URL=
PDFLENS_API_HEALTH_METHOD=GET

# The result API accepts {"request_id": "..."}. Use POST unless your deployed API uses GET.
PDFLENS_API_RESULT_METHOD=POST
PDFLENS_API_TIMEOUT_SECONDS=180

# Result retrieval calls the hosted endpoint repeatedly while it reports queued/processing.
PDFLENS_RESULT_POLL_INTERVAL_SECONDS=5
PDFLENS_RESULT_POLL_MAX_WAIT_SECONDS=900

# Hosted API JWT. Keep the raw token here; the backend sends Bearer plus the token.
# It is sent only from the server to configured PDFLens APIs, never to browser code.
PDFLENS_JWT_TOKEN=
PDFLENS_JWT_HEADER=Authorization
PDFLENS_JWT_PREFIX=Bearer

# Legacy API-key settings remain supported as a fallback for deployments that use API keys.
# PDFLENS_API_KEY=
# PDFLENS_API_KEY_HEADER=Authorization
# PDFLENS_API_KEY_PREFIX=Bearer

# The UI backend writes each PDF under this directory before sending file_path to PDFLens.
# This path must resolve to the same readable location on the hosted PDFLens machine/container.
PDFLENS_SHARED_STORAGE_DIR=/shared/pdflens
PDFLENS_STAGING_DIRECTORY_MODE=750
PDFLENS_STAGING_FILE_MODE=640
PDFLENS_STAGING_RETENTION_HOURS=168
PDFLENS_MAX_RESULT_ZIP_BYTES=524288000

# Configure valid IDs and friendly labels from the PDFLens administrator.
PDFLENS_CONFIGS_JSON='[{"id":"replace-with-valid-config-id","label":"Default configuration"}]'

# Optional. Sent in the submit request; no callback receiver is created by this UI app.
PDFLENS_CALLBACK_URL=

# Existing app-level upload limits
PDFLENS_MAX_UPLOAD_BYTES=52428800
